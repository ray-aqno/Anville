# Copy to .env and fill in. Never commit .env.
# Modal reads these from a Modal Secret named "anville" (created from .env).

# --- Onshape (My Account > Developer > API keys) ---
ONSHAPE_ACCESS_KEY=
ONSHAPE_SECRET_KEY=
ONSHAPE_BASE_URL=https://cad.onshape.com

# Hard cap on counted Onshape API calls per day (the annual quota is per plan)
ONSHAPE_DAILY_CALL_CAP=100

# --- Webhook trust boundary (ADR 0003) ---
# Random secret path segment for the webhook URL
ANVILLE_WEBHOOK_SECRET=
# Comma-separated Onshape document IDs Anville will act on
ANVILLE_ALLOWED_DOCUMENT_IDS=

# --- Models (ADR 0004) ---
# Meta Model API: https://api.meta.ai/v1 (standard mode only, never -contributor IDs)
MODEL_API_KEY=
MUSE_SPARK_MODEL_ID=muse-spark-1.3
# Hosted Muse Spark Open (OpenAI-compatible). Confirm the ID in the provider catalog.
MUSE_SPARK_OPEN_BASE_URL=
MUSE_SPARK_OPEN_API_KEY=
MUSE_SPARK_OPEN_MODEL_ID=meta-models/muse-spark-open-1026
